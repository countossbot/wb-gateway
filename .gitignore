dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/tool-results/

# Agent 工具结果转储（会话临时产物，不入仓库）
/tool-results/

# 用户上传暂存（IM 网关工作区 tar / 备份文件含凭据明文，绝不入库）
/upload/

# SQLite 数据库文件（容器首启由 prisma/init.sql 自动建表；数据经卷持久化，不入仓库）
db
*.db
*.db-shm
*.db-wal
*.db-journal

# 源码下载包（运行时产物，不入仓库）
/public/downloads/

# DB 配置快照（含凭证，绝不入库/出包）
backups/

# 项目记忆目录（本机 agent 工作记录，不入仓库）
/.workbuddy/
