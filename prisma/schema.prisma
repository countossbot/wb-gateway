// Universal-AI-Gateway 重构版 — SQLite 数据层
// 按领域拆分（原项目把所有配置塞成单个 GATEWAY_CONFIG JSON blob，此处拆为关系表）。
// 约束：凭据字段为 Json 明文存储，DB 文件权限 0600 保护（见 README「安全」章节）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Schema 版本与顺序迁移 ----
model SchemaVersion {
  version   Int      @id
  name      String
  appliedAt DateTime @default(now())
}

// ---- 管理员与会话 ----
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // scrypt: salt:hex
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256(cookie token)
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // 滑动续期锚点

  @@index([userId])
}

model LoginAudit {
  id        Int      @id @default(autoincrement())
  ip        String
  userAgent String   @default("")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- 提供商与账号 ----
model Provider {
  id             String   @id // 如 workbuddy / workbuddy-intl / opencode
  name           String
  type           String // workbuddy | openai | anthropic | opencode | qwenweb
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  config         Json // baseUrl / defaultHeaders / region 等非凭据配置
  proxyOverride  String? // null=跟随全局代理；"direct"=直连；其他=专属代理地址（可逗号分隔池）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts Account[]
}

model Account {
  // 复合唯一：provider 内账号 id 唯一（原语义：account.id）
  id              String   @id
  providerId      String
  name            String   @default("")
  enabled         Boolean  @default(true)
  credentials     Json // {userId,accessToken,refreshToken} | {apiKey} | {token,cookie,fingerprint} | {}
  balance         Json? // {balance,total,success,at} 聚合缓存
  cooldownUntil   DateTime?
  cooldownStreak  Int      @default(0)
  cooldownReason  String? // v3.2.2：最近一次进入冷却的原因摘要（如 "429: rate limited"），运维排障用
  lastCheckinAt   DateTime?
  lastCheckinOk   Boolean?
  lastRefreshAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, id])
  @@index([providerId])
}

// ---- 模型路由与候选 ----
model ModelRoute {
  id        Int      @id @default(autoincrement())
  model     String   @unique // 对外模型名
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates RouteCandidate[]
}

model RouteCandidate {
  id         Int     @id @default(autoincrement())
  routeId    Int
  providerId String
  model      String // 上游模型名
  enabled    Boolean @default(true)
  sortOrder  Int

  route ModelRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

// ---- 虚拟密钥 ----
model VirtualKey {
  id        String   @id @default(cuid())
  name      String
  keyValue  String   @unique // 明文密钥（掩码显示 + 保存回填契约见 config 服务）
  keyPrefix String // 展示用前 6 位
  enabled   Boolean  @default(true)
  models    Json // 数组，如 ["*"] 或 ["deepseek-v4.1-flash"]
  role      String   @default("client") // client | cron
  remark    String?
  // v4.3.0：密钥级日配额（本地时区日；0 = 不限额）。超限后网关入口直接 429（不触上游、不消耗额度）。
  // 请求配额按次数计；token 配额按 input+output 累计计。
  // 配额账本复用 UsageDaily 按日聚合（day × apiKeyName 求和）+ 内存缓冲 peek，统计口径与控制台一致。
  dailyRequestLimit Int @default(0)
  dailyTokenLimit   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- 系统设置（键值） ----
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---- 签到日志 ----
model CheckinLog {
  id          Int      @id @default(autoincrement())
  providerId  String
  accountId   String?
  accountName String?
  success     Boolean
  manual      Boolean  @default(false)
  result      Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---- 请求日志 ----
model RequestLog {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  model        String
  protocol     String   @default("openai") // anthropic | openai
  providerId   String?
  accountId    String?
  durationMs   Int?
  status       Int?
  stream       Boolean  @default(false)
  inputTokens  Int?
  outputTokens Int?
  cachedTokens Int?
  apiKeyName   String?
  error        String?
  usageExact   Boolean? // true=上游精确 usage；false=网关字符估算；null=未知/未记录（旧数据或无用量）

  @@index([createdAt])
  @@index([model])
  @@index([providerId])
  // v3.9.3: listRequestLogs 按 apiKeyName/accountId 筛选 + createdAt 排序此前全表扫描
  @@index([apiKeyName, createdAt])
  @@index([accountId, createdAt])
}

// ---- 定时任务执行记录 ----
model JobRun {
  id         Int      @id @default(autoincrement())
  job        String // checkin | keepalive
  triggered  String   @default("cron") // cron | manual
  success    Boolean
  detail     Json?
  startedAt  DateTime @default(now())

  @@index([startedAt])
}

// ---- 用量按日聚合（v3.0.6；v4.2.3 增模型维度）----
// RequestLog 滚动窗口仅保留 5000 条，超大流量下「今日/近 N 天」统计会被截断；
// 本表按「日 × 提供商 × 密钥 × 模型」维度永久累积（维度键空串=未命中/未知/历史未细分，
// 规避 SQLite 复合唯一约束中 NULL 不判等的问题），统计查询不再受滚动窗口影响。
// v4.2.3：新增 model 维度 —— 模型健康 sparkline / Top 模型排行改读本表（根本解），
// 跨滚动窗口持久；v4.2.3 之前的存量行 model=""（启动迁移 splitUsageDailyModelDimension
// 在 RequestLog 完整覆盖该天时安全重切，否则保留空串不参与模型维度统计）。
model UsageDaily {
  id           Int      @id @default(autoincrement())
  day          String // YYYY-MM-DD（服务器本地时区）
  providerId   String   @default("") // 维度键（空串=请求未命中提供商/未知）
  apiKeyName   String   @default("") // 维度键（空串=未识别调用方）
  model        String   @default("") // 维度键（空串=v4.2.3 前历史行/未知模型）
  requests     Int      @default(0)
  okRequests   Int      @default(0) // status ∈ [200, 400)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([day, providerId, apiKeyName, model])
  @@index([day])
}

// ---- 余额按日快照（v3.6.0）----
// 维度：日 × 提供商 × 账号（与 UsageDaily 同款复合唯一 + 空串占位思路）。
// 采集：fleet.getBalance 实测余额时顺带 upsert 当日快照（零额外上游调用）；
// 同日多次刷新取最新值（upsert update 覆盖）。控制台余额趋势 sparkline 消费。
model BalanceSnapshot {
  id          Int      @id @default(autoincrement())
  day         String // YYYY-MM-DD（服务器本地时区，与 UsageDaily 口径一致）
  providerId  String
  accountId   String
  accountName String   @default("")
  balance     Float    @default(0)
  total       Float    @default(0)
  success     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([day, providerId, accountId])
  @@index([day])
  @@index([providerId, accountId])
}

// ---- 控制台操作审计日志（v3.2.0）----
// Task 17「路由全删」生产事故的防御闭环：所有破坏性/关键操作留痕。
// delete 操作在删除前落完整快照（凭据脱敏，可审计追溯与结构恢复参考）；
// 写入失败绝不影响主流程（auditService 内部 catch）。
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String // delete | create | update | toggle | regenerate
  entity     String // provider | account | route | key | setting | system
  entityId   String   @default("") // 被操作对象 ID（路由为数字 id 的字符串形态）
  entityName String   @default("") // 展示名（模型名/账号名/提供商名/密钥名）
  detail     Json? // 删除前快照 / 变更摘要 / 新值（凭据字段已脱敏）
  ip         String   @default("")
  actor      String   @default("admin") // 操作者（当前恒为 admin 会话）
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, action])
}
